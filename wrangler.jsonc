{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salmon-freight-workbench",
  "main": "worker/cloudflare_worker.py",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "base_dir": "worker"
}
